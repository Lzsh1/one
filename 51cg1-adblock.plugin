#!name = 51cg1 广告拦截
#!desc = 拦截 51cg1.com 及镜像站的推广跳转与广告上报，隐藏页面广告容器，并跳过视频播放器的 5 秒贴片广告
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,广告拦截
#!type = normal

# ============================================================
# 站点广告结构（2026-10-18 实测 best.sswbrknqj.cc）
#   列表广告   <article class="ad-item"> + #ad-card-N（服务端渲染，19 个）
#   浮标广告   #adFloat / .xqbj-component-adfloat 内的 .ai-link-ad
#   首页弹窗   .recommend-layer（JS 延迟插入）
#   底部横幅   section.horizontal-block
#   广告素材   pic.gyezbp.cn/hc237/uploads/default/other/<日期>/<hash>.gif
#   视频贴片   .dplayer 的 data-config：ads_skip:0 + ads_duration:5 + video_player_ads[]
#   推广跳转   28 个随机域名
#
# 纯域名规则只能让推广链接失效，无法移除页面里已经渲染出来的广告卡，
# 所以下面额外用一段 [Rewrite] 注入 CSS 隐藏容器；不需要这个效果的话，
# 用 51cg1-adblock-lite.plugin（纯规则、无需 MITM）。
# ============================================================

[Rule]
# --- 列表广告 / 浮标 / 弹窗的推广跳转域名 ---
DOMAIN-SUFFIX,ggtyu341.com,REJECT
DOMAIN-SUFFIX,jspku910.com,REJECT
DOMAIN-SUFFIX,qddcjy.com,REJECT
DOMAIN-SUFFIX,iwangzi.com,REJECT
DOMAIN-SUFFIX,51baoyang.cc,REJECT
DOMAIN-SUFFIX,48398379.com,REJECT
DOMAIN-SUFFIX,67246920.com,REJECT
DOMAIN-SUFFIX,77997225.com,REJECT
DOMAIN-SUFFIX,83907133.com,REJECT
DOMAIN-SUFFIX,2526a0.wd51q64s.cc,REJECT
DOMAIN-SUFFIX,269e.2690125.cc,REJECT
DOMAIN-SUFFIX,275e.2750181.cc,REJECT
DOMAIN-SUFFIX,322t.5836312.cc,REJECT
DOMAIN-SUFFIX,43d73.itkslbju.cc,REJECT
DOMAIN-SUFFIX,583a.2578264.cc,REJECT
DOMAIN-SUFFIX,827a.2454092.cc,REJECT
DOMAIN-SUFFIX,a9fd.lieqlcelo.cc,REJECT
DOMAIN-SUFFIX,aace.51luoliao8.com,REJECT
DOMAIN-SUFFIX,cn785.8d5ck6f.com,REJECT
DOMAIN-SUFFIX,d98.attpqszf.cc,REJECT
DOMAIN-SUFFIX,da8a.vrxgnxct.cc,REJECT
DOMAIN-SUFFIX,e3119.xlvcbxdxk.cc,REJECT
DOMAIN-SUFFIX,f62.avmftran.cc,REJECT
DOMAIN-SUFFIX,jd3223.v8xx0m8.me,REJECT
DOMAIN-SUFFIX,jncx2.yavntsoa.cc,REJECT
DOMAIN-SUFFIX,mc179.nisq0jy.cc,REJECT
DOMAIN-SUFFIX,yc5787.qmhuz9w.me,REJECT
IP-CIDR,154.201.192.169/32,REJECT

# --- 站点自家的广告曝光上报接口 ---
DOMAIN-SUFFIX,zyudkkup.com,REJECT

# 注意：不要按路径拦 pic.gyezbp.cn/hc237/。
# 该图床同时提供广告素材和全部正文图（/upload/、/upload_01/），
# 路径规则需要 MITM 才能匹配，而 MITM 图床会导致正文图加载失败。
# 广告图交给下面的 CSS 隐藏即可。

[MITM]
hostname = 51cg1.com, *.51cg1.com, cg51.com, *.cg51.com, chigua.com, *.chigua.com, sswbrknqj.cc, *.sswbrknqj.cc

[Rewrite]
# 1) 在 </head> 前插入 CSS 隐藏广告容器。
#    URL 正则排除 css/js/图片/字体/视频，避免改写非 HTML 响应。
response if ${url} ~= /^https?:\/\/([^\/]+\.)?(51cg1\.com|cg51\.com|chigua\.com|sswbrknqj\.cc)\/(?!.*\.(?:css|js|png|jpe?g|gif|ico|svg|webp|woff2?|ttf|eot|mp4|m3u8))/ then response.body.replace(/<\/head>/i, "<style id=nsadblock>article.ad-item,#adFloat,.xqbj-component-adfloat,.horizontal-block,.recommend-layer,.ai-link-ad{display:none!important}</style></head>")

# 2) 视频贴片：把 data-config 里的 ads_skip 从 0 改成 1。
#    播放器源码 ads_skip===1 直接返回 null，既不建广告图元素也不发请求，秒进正片。
#    用捕获组回填 ads_skip 后面那个引号，替换串里不含引号，不会破坏 JSON。
response if ${url} ~= /^https?:\/\/([^\/]+\.)?(51cg1\.com|cg51\.com|chigua\.com|sswbrknqj\.cc)\/(?!.*\.(?:css|js|png|jpe?g|gif|ico|svg|webp|woff2?|ttf|eot|mp4|m3u8))/ then response.body.replace(/(ads_skip"):0/, "$1:1")

# 3) 页面里的广告图改指 127.0.0.1，连接立即被拒、图片瞬间 error。
#    实测图床对不存在的路径要 1.8 秒才返回，不能靠改目录名让广告失败。
#    只匹配未转义的 /hc237/ 路径，正文图（/upload/、/upload_01/）不受影响。
response if ${url} ~= /^https?:\/\/([^\/]+\.)?(51cg1\.com|cg51\.com|chigua\.com|sswbrknqj\.cc)\/(?!.*\.(?:css|js|png|jpe?g|gif|ico|svg|webp|woff2?|ttf|eot|mp4|m3u8))/ then response.body.replace(/\/\/pic\.gyezbp\.cn\/hc237\//g, "//127.0.0.1/hc237/")

# 4) hls.js 播放调优（解决快进卡顿）。
#    分片 5 秒一个，默认只预缓冲 30 秒，快进到未缓冲位置要现拉分片，网络抖动就卡。
#    这里在播放器初始化前改 Hls.defaultConfig：加大前向缓冲、预取、提高重试次数。
#    注入串不含引号和空格，避免解析问题。
response if ${url} ~= /^https?:\/\/([^\/]+\.)?(51cg1\.com|cg51\.com|chigua\.com|sswbrknqj\.cc)\/(?!.*\.(?:css|js|png|jpe?g|gif|ico|svg|webp|woff2?|ttf|eot|mp4|m3u8))/ then response.body.replace(/<\/body>/i, "<script>if(window.Hls){window.Hls.DefaultConfig.maxBufferLength=60;window.Hls.DefaultConfig.maxMaxBufferLength=120;window.Hls.DefaultConfig.maxBufferSize=60000000;window.Hls.DefaultConfig.startFragPrefetch=true;window.Hls.DefaultConfig.nudgeMaxRetry=6;window.Hls.DefaultConfig.fragLoadingMaxRetry=6;window.Hls.DefaultConfig.maxBufferHole=0.5};window.k=function(){window.b=document.querySelector('.dplayer-pre-bg');if(window.b){document.querySelectorAll('.dplayer-pre-img,.dplayer-pre-bg,.dplayer-pre-countdown').forEach(function(e){e.remove()});window.v=document.querySelector('video');if(window.v){window.v.muted=false;window.v.play().catch(function(){})}}};Reflect.construct(MutationObserver,[window.k]).observe(document.documentElement,{childList:true,subtree:true});window.k()</script></body>")

# 旧版 Loon（< 3.5.1）不认上面的 v2 写法时，删掉它，改用下面这行等价的 v1 语法：
# ^https?:\/\/([^\/]+\.)?(51cg1\.com|cg51\.com|chigua\.com|sswbrknqj\.cc)\/ response-body-replace-regex <\/head> "<style id=nsadblock>article.ad-item,#adFloat,.xqbj-component-adfloat,.horizontal-block,.recommend-layer,.ai-link-ad{display:none!important}</style></head>"
